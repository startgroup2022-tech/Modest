# ─── Attention Modest Fashion — environment configuration ───
# Copy to .env and fill in real values. NEVER commit .env.

# Database (MySQL 8 / MariaDB 10.4+)
DATABASE_URL="mysql://attention:attention@127.0.0.1:3307/attention"

# Auth — generate with: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"

# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Payment providers (all optional; leave blank to disable) ───
# TAPP (Bahrain) — configure in Admin → Payment Settings or via env
TAPP_ENV="sandbox"
TAPP_BASE_URL="https://api.tapp.sa"
TAPP_MERCHANT_ID=""
TAPP_API_KEY=""
TAPP_WEBHOOK_SECRET=""

# BenefitPay / BENEFIT transfer details (shown to customer, verified manually)
BENEFIT_ALIAS=""
BENEFIT_ACCOUNT_NAME="Attention Modest Fashion"
BENEFIT_ACCOUNT_NUMBER=""

# Bank transfer details
BANK_NAME=""
BANK_IBAN=""
BANK_ACCOUNT_NAME="Attention Modest Fashion"

# ─── Seed bootstrap (used only by `npm run db:seed`) ───
SEED_ADMIN_EMAIL="admin@attention-modestfashion.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_DEMO_CUSTOMER="customer@example.com"
SEED_DEMO_PASSWORD="Customer123!"
