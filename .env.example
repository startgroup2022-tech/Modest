# ─── Attention Modest Fashion — environment configuration ───
# Copy to .env and fill in real values. NEVER commit .env.
# On cPanel these live in: Setup Node.js App → Environment Variables.
#
# Values marked [ADMIN] may instead be entered in the Admin UI
# (Admin → Settings → Payments / Store). A value set in the Admin UI takes
# precedence over the environment variable. Server secrets that must never be
# readable by a browser session (database, auth signing) are [SERVER]-only.

# ─── [SERVER] Core (required) ───
# MySQL 8 / MariaDB 10.4+. On cPanel the host is normally localhost:3306.
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/DATABASE"
# Session/JWT signing key. Generate with: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"
# Canonical public origin, NO trailing slash. Used for canonical URLs, sitemap,
# hreflang and metadataBase.
NEXT_PUBLIC_SITE_URL="https://attention-modestfashion.com"
# Absolute origin used to build payment return/callback URLs server-side.
APP_URL="https://attention-modestfashion.com"

# ─── [ADMIN] Payment providers (all optional; leave blank to disable) ───
# TAPP (Bahrain). The on/off switch is Admin → Settings → Payments; the values
# below only supply credentials. Keep TAPP disabled until real credentials
# exist — a disabled TAPP is simply not offered at checkout.
TAPP_ENV="sandbox"                 # "sandbox" | "live"
TAPP_BASE_URL="https://api.tapp.sa"
TAPP_MERCHANT_ID=""
TAPP_API_KEY=""
TAPP_WEBHOOK_SECRET=""

# BenefitPay / BENEFIT transfer details (shown to the customer, verified manually)
BENEFIT_ALIAS=""
BENEFIT_ACCOUNT_NAME="Attention Modest Fashion"
BENEFIT_ACCOUNT_NUMBER=""

# Bank transfer details
BANK_NAME=""
BANK_IBAN=""
BANK_ACCOUNT_NAME="Attention Modest Fashion"

# ─── Seed bootstrap (used ONLY by `npm run db:seed`) ───
# Not needed on a running production server except during the initial seed.
# Remove/blank SEED_ADMIN_PASSWORD afterwards.
SEED_ADMIN_EMAIL="admin@attention-modestfashion.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_DEMO_CUSTOMER="customer@example.com"
SEED_DEMO_PASSWORD="Customer123!"
