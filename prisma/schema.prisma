// Attention Modest Fashion — Prisma schema
// Database: MySQL (cPanel compatible)
// Accounting currency: BHD. All monetary values stored as Decimal.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────────────────────────────────────
// Identity & access
// ───────────────────────────────────────────────────────────

enum RoleName {
  ADMIN
  MANAGER
  SUPPORT
  CUSTOMER
}

model Role {
  id          String        @id @default(cuid())
  name        RoleName      @unique
  description String?
  users       User[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  passwordHash  String?
  firstName     String?
  lastName      String?
  phone         String?
  roleId        String?
  role          Role?           @relation(fields: [roleId], references: [id], onDelete: SetNull)
  emailVerified DateTime?
  isActive      Boolean         @default(true)
  locale        String          @default("en")
  lastLoginAt   DateTime?
  customer      Customer?
  auditLogs     AuditLog[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([roleId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

// ───────────────────────────────────────────────────────────
// Customers
// ───────────────────────────────────────────────────────────

model Customer {
  id            String         @id @default(cuid())
  userId        String         @unique
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone         String?
  defaultLocale String         @default("en")
  acceptsMarketing Boolean     @default(false)
  addresses     Address[]
  measurements  Measurement[]
  orders        Order[]
  wishlist      WishlistItem[]
  cart          Cart?
  notifications Notification[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String?
  fullName   String
  phone      String
  country    String
  city       String
  area       String?
  address    String
  building   String?
  unit       String?
  notes      String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId])
}

// Body measurements used for made-to-order tailoring (values in cm)
model Measurement {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String   @default("My measurements")
  unit       String   @default("cm")
  height     Decimal? @db.Decimal(6, 2)
  shoulder   Decimal? @db.Decimal(6, 2)
  bust       Decimal? @db.Decimal(6, 2)
  waist      Decimal? @db.Decimal(6, 2)
  hip        Decimal? @db.Decimal(6, 2)
  sleeve     Decimal? @db.Decimal(6, 2)
  armhole    Decimal? @db.Decimal(6, 2)
  length     Decimal? @db.Decimal(6, 2)
  notes      String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId])
}

// ───────────────────────────────────────────────────────────
// Catalogue
// ───────────────────────────────────────────────────────────

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductKind {
  READY_TO_WEAR
  MADE_TO_ORDER
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  nameEn      String
  nameAr      String
  descriptionEn String? @db.Text
  descriptionAr String? @db.Text
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  products    ProductCategory[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Collection {
  id           String    @id @default(cuid())
  slug         String    @unique
  nameEn       String
  nameAr       String
  taglineEn    String?
  taglineAr    String?
  descriptionEn String?  @db.Text
  descriptionAr String?  @db.Text
  heroImage    String?
  sortOrder    Int       @default(0)
  isFeatured   Boolean   @default(false)
  isActive     Boolean   @default(true)
  products     ProductCollection[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Product {
  id             String          @id @default(cuid())
  slug           String          @unique
  sku            String?         @unique
  nameEn         String
  nameAr         String
  subtitleEn     String?
  subtitleAr     String?
  descriptionEn  String?         @db.Text
  descriptionAr  String?         @db.Text
  detailsEn      String?         @db.Text
  detailsAr      String?         @db.Text
  materialsEn    String?         @db.Text
  materialsAr    String?         @db.Text
  careEn         String?         @db.Text
  careAr         String?         @db.Text
  priceBhd       Decimal         @db.Decimal(10, 3)
  compareAtBhd   Decimal?        @db.Decimal(10, 3)
  status         ProductStatus   @default(ACTIVE)
  kind           ProductKind     @default(READY_TO_WEAR)
  isFeatured     Boolean         @default(false)
  isNewArrival   Boolean         @default(false)
  madeToOrder    Boolean         @default(false)
  leadTimeMinDays Int            @default(14)
  leadTimeMaxDays Int            @default(21)
  metaTitleEn    String?
  metaTitleAr    String?
  metaDescEn     String?
  metaDescAr     String?
  media          ProductMedia[]
  variants       ProductVariant[]
  categories     ProductCategory[]
  collections    ProductCollection[]
  orderItems     OrderItem[]
  wishlistItems  WishlistItem[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([status])
  @@index([isFeatured])
  @@index([isNewArrival])
}

model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
}

model ProductCollection {
  productId    String
  collectionId String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
  @@index([collectionId])
}

model ProductMedia {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String  @db.Text
  altEn     String?
  altAr     String?
  width     Int?
  height    Int?
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  @@index([productId])
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  PRE_ORDER
}

model ProductVariant {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku        String?     @unique
  size       String
  colorEn    String?
  colorAr    String?
  priceBhd   Decimal?    @db.Decimal(10, 3)
  stock      Int         @default(0)
  stockStatus StockStatus @default(IN_STOCK)
  isActive   Boolean     @default(true)
  sortOrder  Int         @default(0)
  orderItems OrderItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([productId])
}

// ───────────────────────────────────────────────────────────
// Currency & pricing
// ───────────────────────────────────────────────────────────

model Currency {
  id             String   @id @default(cuid())
  code           String   @unique
  nameEn         String
  nameAr         String
  symbolEn       String
  symbolAr       String
  decimals       Int      @default(2)
  symbolPosition String   @default("prefix") // prefix | suffix
  rateToBhd      Decimal  @db.Decimal(18, 8) // 1 BHD = rateToBhd units of this currency
  isActive       Boolean  @default(true)
  isDefault      Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Historical record of exchange rate changes — never mutates past orders.
model ExchangeRate {
  id          String   @id @default(cuid())
  currencyId  String
  code        String
  rateToBhd   Decimal  @db.Decimal(18, 8)
  effectiveAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([code, effectiveAt])
}

// ───────────────────────────────────────────────────────────
// Marketing
// ───────────────────────────────────────────────────────────

enum DiscountType {
  PERCENTAGE
  FIXED
  FREE_SHIPPING
}

model Coupon {
  id             String       @id @default(cuid())
  code           String       @unique
  descriptionEn  String?
  descriptionAr  String?
  discountType   DiscountType
  valueBhd       Decimal      @db.Decimal(10, 3) @default(0)
  minOrderBhd    Decimal?     @db.Decimal(10, 3)
  maxDiscountBhd Decimal?     @db.Decimal(10, 3)
  usageLimit     Int?
  usedCount      Int          @default(0)
  perCustomerLimit Int?
  startsAt       DateTime?
  expiresAt      DateTime?
  isActive       Boolean      @default(true)
  orders         Order[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Promotion {
  id          String   @id @default(cuid())
  titleEn     String
  titleAr     String
  bodyEn      String?  @db.Text
  bodyAr      String?  @db.Text
  ctaLabelEn  String?
  ctaLabelAr  String?
  ctaHref     String?
  imageUrl    String?
  placement   String   @default("announcement") // announcement | home_banner
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ───────────────────────────────────────────────────────────
// Orders & payments
// ───────────────────────────────────────────────────────────

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  IN_PRODUCTION
  QUALITY_CHECK
  READY
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentMethodType {
  COD
  BANK_TRANSFER
  BENEFIT
  TAPP
}

enum PaymentStatus {
  INITIATED
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

model Order {
  id                String        @id @default(cuid())
  orderNumber       String        @unique
  customerId        String?
  customer          Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  email             String
  phone             String
  shippingName      String
  shippingCountry   String
  shippingCity      String
  shippingArea      String?
  shippingAddress   String
  shippingBuilding  String?
  shippingUnit      String?
  notes             String?       @db.Text
  status            OrderStatus   @default(PENDING)
  // Accounting currency snapshot (BHD)
  subtotalBhd       Decimal       @db.Decimal(12, 3)
  discountBhd       Decimal       @db.Decimal(12, 3) @default(0)
  shippingBhd       Decimal       @db.Decimal(12, 3) @default(0)
  totalBhd          Decimal       @db.Decimal(12, 3)
  // Presentment currency snapshot — preserved forever
  presentmentCode   String        @default("BHD")
  presentmentRate   Decimal       @db.Decimal(18, 8) @default(1)
  presentmentTotal  Decimal       @db.Decimal(12, 3) @default(0)
  rateCapturedAt    DateTime      @default(now())
  couponId          String?
  coupon            Coupon?       @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode        String?
  idempotencyKey    String?       @unique
  items             OrderItem[]
  payments          Payment[]
  refunds           Refund[]
  events            OrderEvent[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id            String          @id @default(cuid())
  orderId       String
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId     String?
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  // Immutable historical snapshot
  productName   String
  variantLabel  String?
  sku           String?
  imageUrl      String?         @db.Text
  unitPriceBhd  Decimal         @db.Decimal(10, 3)
  quantity      Int
  lineTotalBhd  Decimal         @db.Decimal(12, 3)

  @@index([orderId])
}

model Payment {
  id            String            @id @default(cuid())
  orderId       String
  order         Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method        PaymentMethodType
  provider      String            @default("manual")
  status        PaymentStatus     @default(INITIATED)
  amountBhd     Decimal           @db.Decimal(12, 3)
  currencyCode  String            @default("BHD")
  amountPresentment Decimal?      @db.Decimal(12, 3)
  providerRef   String?
  providerPayload Json?
  signatureVerified Boolean       @default(false)
  paidAt        DateTime?
  failedReason  String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([orderId])
  @@index([status])
}

model Refund {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amountBhd   Decimal  @db.Decimal(12, 3)
  reason      String?
  reference   String?
  createdAt   DateTime @default(now())

  @@index([orderId])
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  messageEn String?
  messageAr String?
  createdAt DateTime    @default(now())

  @@index([orderId])
}

// ───────────────────────────────────────────────────────────
// Wishlist & notifications
// ───────────────────────────────────────────────────────────

model WishlistItem {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
  @@index([customerId])
}

// Persistent cart. Guests are keyed by an opaque cookie token; signed-in
// customers by customerId. Both are merged on sign-in.
model Cart {
  id         String     @id @default(cuid())
  token      String?    @unique
  customerId String?    @unique
  customer   Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items      CartItem[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model CartItem {
  id        String    @id @default(cuid())
  cartId    String
  cart      Cart      @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  variantId String?
  quantity  Int       @default(1)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([cartId, productId, variantId])
  @@index([cartId])
}

model Notification {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  titleEn    String
  titleAr    String
  bodyEn     String?  @db.Text
  bodyAr     String?  @db.Text
  href       String?
  readAt     DateTime?
  createdAt  DateTime @default(now())

  @@index([customerId])
}

// ───────────────────────────────────────────────────────────
// Site content (admin-controlled) & settings
// ───────────────────────────────────────────────────────────

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model HomeSection {
  id        String   @id @default(cuid())
  key       String   @unique
  kind      String   // hero | collections | featured | story | made_to_order | social | newsletter
  titleEn   String?
  titleAr   String?
  bodyEn    String?  @db.Text
  bodyAr    String?  @db.Text
  ctaLabelEn String?
  ctaLabelAr String?
  ctaHref   String?
  imageUrl  String?  @db.Text
  mobileImageUrl String? @db.Text
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SocialLink {
  id       String  @id @default(cuid())
  platform String
  url      String
  labelEn  String?
  labelAr  String?
  isActive Boolean @default(true)
  sortOrder Int    @default(0)
}

model Page {
  id       String @id @default(cuid())
  slug     String @unique
  titleEn  String
  titleAr  String
  bodyEn   String @db.LongText
  bodyAr   String @db.LongText
  isActive Boolean @default(true)
  updatedAt DateTime @updatedAt
}

model ShippingMethod {
  id            String   @id @default(cuid())
  code          String   @unique
  nameEn        String
  nameAr        String
  descriptionEn String?
  descriptionAr String?
  priceBhd      Decimal  @db.Decimal(10, 3) @default(0)
  freeOverBhd   Decimal? @db.Decimal(10, 3)
  countries     Json?
  etaMinDays    Int      @default(2)
  etaMaxDays    Int      @default(5)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  locale    String   @default("en")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}
