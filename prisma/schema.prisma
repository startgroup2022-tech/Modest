// Attention Modest Fashion — Prisma schema
// Database: MySQL (cPanel compatible)
// Accounting currency: BHD. All monetary values stored as Decimal.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────────────────────────────────────
// Identity & access
// ───────────────────────────────────────────────────────────

enum RoleName {
  ADMIN
  MANAGER
  SUPPORT
  CUSTOMER
  // Tailor Portal accounts authenticate against the same session machinery but
  // are limited to their own assigned work; see TailorCredential.
  TAILOR
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Role {
  id          String           @id @default(cuid())
  name        RoleName         @unique
  description String?
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

// Granular permission grants. Authorization is always enforced server-side;
// hiding a button is never treated as authorization.
model RolePermission {
  id         String @id @default(cuid())
  roleId     String
  role       Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission String

  @@unique([roleId, permission])
  @@index([roleId])
}

// Employee-specific permission overrides. Effective permissions are resolved as
// (role permissions ∪ ALLOW overrides) \ DENY overrides, so two employees with
// the same job title can hold different permissions. The job title is never
// consulted for authorization.
enum PermissionEffect {
  ALLOW
  DENY
}

model UserPermission {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission String
  effect     PermissionEffect @default(ALLOW)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([userId, permission])
  @@index([userId])
}

model User {
  id                     String              @id @default(cuid())
  email                  String              @unique
  passwordHash           String?
  firstName              String?
  lastName               String?
  phone                  String?
  jobTitle               String?
  notes                  String?             @db.Text
  status                 EmployeeStatus      @default(ACTIVE)
  roleId                 String?
  role                   Role?               @relation(fields: [roleId], references: [id], onDelete: SetNull)
  emailVerified          DateTime?
  isActive               Boolean             @default(true)
  locale                 String              @default("en")
  lastLoginAt            DateTime?
  // Bumped whenever the account is disabled, its permissions change, or its
  // role changes. The value is embedded in the session JWT; a mismatch on the
  // next authenticated request invalidates that session immediately.
  sessionVersion         Int                 @default(0)
  permissionOverrides    UserPermission[]
  customer               Customer?
  auditLogs              AuditLog[]
  staffNotifications     StaffNotification[]
  productionTasksCreated ProductionTask[]    @relation("ProductionTaskCreator")
  expensesSubmitted      Expense[]           @relation("ExpenseSubmitter")
  expensesApproved       Expense[]           @relation("ExpenseApprover")
  settlementsApproved    TailorSettlement[]  @relation("SettlementApprover")
  refundsCreated         Refund[]            @relation("RefundCreator")
  paymentsVerified       Payment[]           @relation("PaymentVerifier")
  paymentLinksSent       Payment[]           @relation("PaymentLinkSender")
  inventoryMovements     InventoryMovement[] @relation("InventoryActor")
  qcRecords              QcRecord[]          @relation("QcChecker")
  ordersCreated          Order[]             @relation("OrderCreator")
  quickOrderLinksCreated QuickOrderLink[]    @relation("QuickOrderLinkCreator")
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@index([roleId])
  @@index([status])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

// ───────────────────────────────────────────────────────────
// Customers
// ───────────────────────────────────────────────────────────

model Customer {
  id               String             @id @default(cuid())
  userId           String             @unique
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone            String?
  defaultLocale    String             @default("en")
  acceptsMarketing Boolean            @default(false)
  // Optional cached membership pointer. The authoritative tier is *derived*
  // from qualifying paid, non-refunded items; this column only caches the last
  // computed tier so lists do not recompute on every render.
  membershipTierId String?
  membershipTier   MembershipTier?    @relation(fields: [membershipTierId], references: [id], onDelete: SetNull)
  addresses        Address[]
  measurements     Measurement[]
  orders           Order[]
  wishlist         WishlistItem[]
  cart             Cart?
  notifications    Notification[]
  redemptions      CouponRedemption[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([membershipTierId])
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String?
  fullName   String
  phone      String
  country    String
  city       String
  area       String?
  address    String
  building   String?
  unit       String?
  notes      String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId])
}

// Body measurements used for made-to-order tailoring.
//
// Legacy fixed columns (height/shoulder/…) are retained so existing rows and
// screens keep working. New profiles additionally carry `cutId` plus a JSON
// `values` map keyed by MeasurementField.key, which is what the size-guide
// foundation reads. An order always snapshots its own copy, so editing a
// profile here never alters a previous order.
model Measurement {
  id         String      @id @default(cuid())
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String      @default("My measurements")
  unit       String      @default("cm")
  cutId      String?
  cut        ProductCut? @relation(fields: [cutId], references: [id])
  values     Json?
  height     Decimal?    @db.Decimal(6, 2)
  shoulder   Decimal?    @db.Decimal(6, 2)
  bust       Decimal?    @db.Decimal(6, 2)
  waist      Decimal?    @db.Decimal(6, 2)
  hip        Decimal?    @db.Decimal(6, 2)
  sleeve     Decimal?    @db.Decimal(6, 2)
  armhole    Decimal?    @db.Decimal(6, 2)
  length     Decimal?    @db.Decimal(6, 2)
  notes      String?
  isDefault  Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([customerId])
  @@index([cutId])
}

// ───────────────────────────────────────────────────────────
// Catalogue
// ───────────────────────────────────────────────────────────

enum ProductStatus {
  DRAFT
  ACTIVE
  PREORDER
  UNAVAILABLE
  ARCHIVED
}

enum ProductKind {
  READY_TO_WEAR
  MADE_TO_ORDER
}

model Category {
  id            String            @id @default(cuid())
  slug          String            @unique
  nameEn        String
  nameAr        String
  descriptionEn String?           @db.Text
  descriptionAr String?           @db.Text
  imageUrl      String?           @db.Text
  metaTitleEn   String?
  metaTitleAr   String?
  metaDescEn    String?
  metaDescAr    String?
  noIndex       Boolean           @default(false)
  sortOrder     Int               @default(0)
  isActive      Boolean           @default(true)
  products      ProductCategory[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model Collection {
  id            String              @id @default(cuid())
  slug          String              @unique
  nameEn        String
  nameAr        String
  taglineEn     String?
  taglineAr     String?
  descriptionEn String?             @db.Text
  descriptionAr String?             @db.Text
  heroImage     String?
  metaTitleEn   String?
  metaTitleAr   String?
  metaDescEn    String?
  metaDescAr    String?
  noIndex       Boolean             @default(false)
  sortOrder     Int                 @default(0)
  isFeatured    Boolean             @default(false)
  isActive      Boolean             @default(true)
  products      ProductCollection[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

model Product {
  id                 String              @id @default(cuid())
  slug               String              @unique
  sku                String?             @unique
  nameEn             String
  nameAr             String
  subtitleEn         String?
  subtitleAr         String?
  descriptionEn      String?             @db.Text
  descriptionAr      String?             @db.Text
  detailsEn          String?             @db.Text
  detailsAr          String?             @db.Text
  materialsEn        String?             @db.Text
  materialsAr        String?             @db.Text
  careEn             String?             @db.Text
  careAr             String?             @db.Text
  priceBhd           Decimal             @db.Decimal(10, 3)
  compareAtBhd       Decimal?            @db.Decimal(10, 3)
  status             ProductStatus       @default(ACTIVE)
  kind               ProductKind         @default(READY_TO_WEAR)
  isFeatured         Boolean             @default(false)
  isNewArrival       Boolean             @default(false)
  madeToOrder        Boolean             @default(false)
  leadTimeMinDays    Int                 @default(14)
  leadTimeMaxDays    Int                 @default(21)
  metaTitleEn        String?
  metaTitleAr        String?
  metaDescEn         String?
  metaDescAr         String?
  ogImage            String?
  noIndex            Boolean             @default(false)
  lowStockThreshold  Int                 @default(5)
  shippingNoteEn     String?
  shippingNoteAr     String?
  // Silhouette/cut drives the ready-size guide and custom measurement fields.
  // Nullable so products that predate cuts migrate safely.
  cutId              String?
  cut                ProductCut?         @relation(fields: [cutId], references: [id])
  // Current tailoring fee for one piece. It is the *default* only — the fee is
  // frozen onto the assignment/order item at assignment time and later edits
  // here must never change historical dues. No hidden fallback exists.
  tailorFeeBhd       Decimal?            @db.Decimal(10, 3)
  // When true the storefront may display the remaining numeric quantity for a
  // limited-stock piece. When false the quantity is hidden but still enforced.
  showAvailability   Boolean             @default(true)
  media              ProductMedia[]
  variants           ProductVariant[]
  categories         ProductCategory[]
  collections        ProductCollection[]
  orderItems         OrderItem[]
  wishlistItems      WishlistItem[]
  inventoryMovements InventoryMovement[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([status])
  @@index([isFeatured])
  @@index([isNewArrival])
}

model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
}

model ProductCollection {
  productId    String
  collectionId String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
  @@index([collectionId])
}

model ProductMedia {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String  @db.Text
  altEn     String?
  altAr     String?
  width     Int?
  height    Int?
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  @@index([productId])
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  PRE_ORDER
}

model ProductVariant {
  id                 String              @id @default(cuid())
  productId          String
  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku                String?             @unique
  size               String
  colorEn            String?
  colorAr            String?
  priceBhd           Decimal?            @db.Decimal(10, 3)
  stock              Int                 @default(0)
  reserved           Int                 @default(0)
  incoming           Int                 @default(0)
  costBhd            Decimal?            @db.Decimal(10, 3)
  stockStatus        StockStatus         @default(IN_STOCK)
  isActive           Boolean             @default(true)
  sortOrder          Int                 @default(0)
  orderItems         OrderItem[]
  inventoryMovements InventoryMovement[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([productId])
}

// ───────────────────────────────────────────────────────────
// Inventory ledger — stock is never changed silently
// ───────────────────────────────────────────────────────────

enum InventoryMovementType {
  SALE
  RESERVATION
  RELEASE
  MANUAL_ADJUSTMENT
  RETURN
  RESTOCK
  DAMAGE
  QC_REJECTED
  CANCELLATION
}

model InventoryMovement {
  id         String                @id @default(cuid())
  variantId  String
  variant    ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Cascade)
  productId  String
  product    Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  type       InventoryMovementType
  quantity   Int // signed delta applied to stock
  stockAfter Int
  reason     String?
  orderId    String?
  actorId    String?
  actor      User?                 @relation("InventoryActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt  DateTime              @default(now())

  @@index([variantId, createdAt])
  @@index([productId])
  @@index([type])
  @@index([createdAt])
}

// ───────────────────────────────────────────────────────────
// Size guide & cuts — the database is the source of truth
// ───────────────────────────────────────────────────────────

enum MeasurementKind {
  READY
  CUSTOM
}

// A product silhouette/cut (e.g. Tailored, Bisht). The cut determines which
// ready-size chart and which custom measurement fields a product uses.
model ProductCut {
  id            String             @id @default(cuid())
  code          String             @unique // stable machine key, e.g. TAILORED / BISHT
  nameEn        String
  nameAr        String
  descriptionEn String?            @db.Text
  descriptionAr String?            @db.Text
  isActive      Boolean            @default(true)
  sortOrder     Int                @default(0)
  products      Product[]
  sizeCharts    SizeChart[]
  fields        MeasurementField[]
  measurements  Measurement[]
  orderItems    OrderItem[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([isActive])
}

// One ready-size chart per cut. Cell values live in SizeChartValue so a field
// carries its own metadata (labels, unit, min/max, helper text).
model SizeChart {
  id        String           @id @default(cuid())
  cutId     String
  cut       ProductCut       @relation(fields: [cutId], references: [id], onDelete: Cascade)
  unit      String           @default("inch")
  isActive  Boolean          @default(true)
  values    SizeChartValue[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([cutId])
  @@index([cutId])
}

// Custom measurement field metadata for a cut. The same field also holds the
// per-ready-size value in SizeChartValue, so "ready size" and "custom" share
// one definition.
model MeasurementField {
  id        String           @id @default(cuid())
  cutId     String
  cut       ProductCut       @relation(fields: [cutId], references: [id], onDelete: Cascade)
  key       String // stable key, e.g. shoulder_width
  labelEn   String
  labelAr   String
  unit      String           @default("inch")
  minValue  Decimal?         @db.Decimal(6, 2)
  maxValue  Decimal?         @db.Decimal(6, 2)
  helperEn  String?          @db.Text
  helperAr  String?          @db.Text
  isActive  Boolean          @default(true)
  sortOrder Int              @default(0)
  values    SizeChartValue[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([cutId, key])
  @@index([cutId])
}

model SizeChartValue {
  id        String           @id @default(cuid())
  chartId   String
  chart     SizeChart        @relation(fields: [chartId], references: [id], onDelete: Cascade)
  fieldId   String
  field     MeasurementField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  sizeCode  String // XS / S / M / L / XL
  value     Decimal          @db.Decimal(6, 2)
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([chartId, fieldId, sizeCode])
  @@index([chartId])
  @@index([fieldId])
}

// ───────────────────────────────────────────────────────────
// Currency & pricing
// ───────────────────────────────────────────────────────────

model Currency {
  id             String   @id @default(cuid())
  code           String   @unique
  nameEn         String
  nameAr         String
  symbolEn       String
  symbolAr       String
  decimals       Int      @default(2)
  symbolPosition String   @default("prefix") // prefix | suffix
  rateToBhd      Decimal  @db.Decimal(18, 8) // 1 BHD = rateToBhd units of this currency
  isActive       Boolean  @default(true)
  isDefault      Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Historical record of exchange rate changes — never mutates past orders.
model ExchangeRate {
  id          String   @id @default(cuid())
  currencyId  String
  code        String
  rateToBhd   Decimal  @db.Decimal(18, 8)
  effectiveAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([code, effectiveAt])
}

// ───────────────────────────────────────────────────────────
// Marketing
// ───────────────────────────────────────────────────────────

enum DiscountType {
  PERCENTAGE
  FIXED
  FREE_SHIPPING
}

model Coupon {
  id                  String             @id @default(cuid())
  code                String             @unique
  descriptionEn       String?
  descriptionAr       String?
  discountType        DiscountType
  valueBhd            Decimal            @default(0) @db.Decimal(10, 3)
  minOrderBhd         Decimal?           @db.Decimal(10, 3)
  maxDiscountBhd      Decimal?           @db.Decimal(10, 3)
  usageLimit          Int?
  usedCount           Int                @default(0)
  perCustomerLimit    Int?
  // Restrictions — empty arrays mean "no restriction"
  categoryIds         Json?
  collectionIds       Json?
  productIds          Json?
  currencyCodes       Json?
  startsAt            DateTime?
  expiresAt           DateTime?
  isActive            Boolean            @default(true)
  // Membership targeting: when set, only a customer whose *server-computed*
  // qualifying paid-piece count is at least this value may use the code.
  minQualifyingPieces Int?
  orders              Order[]
  redemptions         CouponRedemption[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

// One row per coupon use, kept for audit and per-customer limits. The row is
// never deleted on refund: a refund stamps `revertedAt` so history stays
// traceable while the redemption stops counting toward the customer's active
// eligibility.
model CouponRedemption {
  id             String    @id @default(cuid())
  couponId       String
  coupon         Coupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  orderId        String?
  order          Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  // Guest identity anchor when no customer account exists: a hash of the email,
  // never the raw address, so a guest cannot be trivially enumerated.
  guestEmailHash String?
  amountBhd      Decimal   @default(0) @db.Decimal(12, 3)
  // Null while the redemption is active; stamped when the qualifying order is
  // fully refunded so the code can be reused and per-customer limits relax.
  revertedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([couponId])
  @@index([customerId])
  @@index([orderId])
  @@index([guestEmailHash])
}

model Promotion {
  id         String    @id @default(cuid())
  titleEn    String
  titleAr    String
  bodyEn     String?   @db.Text
  bodyAr     String?   @db.Text
  ctaLabelEn String?
  ctaLabelAr String?
  ctaHref    String?
  imageUrl   String?
  placement  String    @default("announcement") // announcement | home_banner
  isActive   Boolean   @default(true)
  sortOrder  Int       @default(0)
  startsAt   DateTime?
  endsAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// ───────────────────────────────────────────────────────────
// Orders & payments
// ───────────────────────────────────────────────────────────

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  IN_PRODUCTION
  QUALITY_CHECK
  READY
  SHIPPED
  DELIVERED
  CANCELLED
  REFUND_REQUESTED
  REFUNDED
}

enum OrderChannel {
  ONLINE
  QUICK_ORDER
  WHATSAPP
  INSTAGRAM
  PHONE
  WALK_IN
  MANUAL
}

enum PaymentMethodType {
  COD
  BANK_TRANSFER
  BENEFIT
  TAPP
}

enum PaymentStatus {
  INITIATED
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Order {
  id                 String             @id @default(cuid())
  orderNumber        String             @unique
  customerId         String?
  customer           Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  email              String
  phone              String
  shippingName       String
  shippingCountry    String
  shippingCity       String
  shippingArea       String?
  shippingAddress    String
  shippingBuilding   String?
  shippingUnit       String?
  notes              String?            @db.Text
  status             OrderStatus        @default(PENDING)
  // Accounting currency snapshot (BHD)
  subtotalBhd        Decimal            @db.Decimal(12, 3)
  discountBhd        Decimal            @default(0) @db.Decimal(12, 3)
  shippingBhd        Decimal            @default(0) @db.Decimal(12, 3)
  totalBhd           Decimal            @db.Decimal(12, 3)
  // Presentment currency snapshot — preserved forever
  presentmentCode    String             @default("BHD")
  presentmentRate    Decimal            @default(1) @db.Decimal(18, 8)
  presentmentTotal   Decimal            @default(0) @db.Decimal(12, 3)
  rateCapturedAt     DateTime           @default(now())
  couponId           String?
  coupon             Coupon?            @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode         String?
  // Storefront locale the order was placed in. Used so a resent payment link
  // and provider return URLs land the customer in their own language.
  locale             String             @default("en")
  idempotencyKey     String?            @unique
  channel            OrderChannel       @default(ONLINE)
  priority           Int                @default(0)
  internalNotes      String?            @db.Text
  createdById        String?
  createdBy          User?              @relation("OrderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  shippingMethodCode String?
  // The shipping company (carrier) chosen for this order, distinct from the
  // shipping *method* (price/ETA). Nullable for historical orders.
  shippingCompanyId  String?
  shippingCompany    ShippingCompany?   @relation(fields: [shippingCompanyId], references: [id], onDelete: SetNull)
  trackingNumber     String?
  carrier            String?
  // Expected delivery date used to compute the "late" condition. "Late" is
  // never a workflow state — it is derived from this date plus an open status.
  expectedDeliveryAt DateTime?
  shippedAt          DateTime?
  deliveredAt        DateTime?
  cancelledAt        DateTime?
  cancelReason       String?
  items              OrderItem[]
  payments           Payment[]
  refunds            Refund[]
  events             OrderEvent[]
  productionTasks    ProductionTask[]
  quickOrderLinks    QuickOrderLink[]
  redemptions        CouponRedemption[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@index([channel])
  @@index([shippingCompanyId])
}

model OrderItem {
  id           String          @id @default(cuid())
  orderId      String
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  // Immutable historical snapshot
  productName  String
  variantLabel String?
  sku          String?
  imageUrl     String?         @db.Text
  unitPriceBhd Decimal         @db.Decimal(10, 3)
  quantity     Int
  lineTotalBhd Decimal         @db.Decimal(12, 3)

  // ── Measurement snapshot (P0 data integrity) ─────────────
  // Frozen copy of the measurements used when the piece was ordered. Written
  // once at order creation and never recomputed, so editing the live size
  // guide or a customer's saved profile cannot change a past order.
  measurementKind     MeasurementKind?
  sizeCode            String? // READY: XS/S/M/L/XL
  sizeSnapshot        Json? // READY: { unit, values: { fieldKey: value } }
  measurementSnapshot Json? // CUSTOM: { unit, cutCode, values, fieldLabels, profileId? }
  cutId               String?
  cut                 ProductCut?      @relation(fields: [cutId], references: [id], onDelete: SetNull)

  // ── Per-item tailor assignment & frozen fee (P0 financial) ──
  // Assignment is per piece. The fee is copied from the product's current
  // tailorFeeBhd at assignment time; later product fee changes never touch it.
  assignedTailorId String?
  assignedTailor   Tailor?   @relation("TailorAssignments", fields: [assignedTailorId], references: [id], onDelete: SetNull)
  assignedAt       DateTime?
  tailorFeeBhd     Decimal?  @db.Decimal(10, 3)

  productionTasks ProductionTask[]
  qcRecords       QcRecord[]
  settlementItems TailorSettlementItem[]

  @@index([orderId])
  @@index([assignedTailorId])
  @@index([cutId])
}

model Payment {
  id                String            @id @default(cuid())
  orderId           String
  order             Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method            PaymentMethodType
  provider          String            @default("manual")
  status            PaymentStatus     @default(INITIATED)
  amountBhd         Decimal           @db.Decimal(12, 3)
  currencyCode      String            @default("BHD")
  amountPresentment Decimal?          @db.Decimal(12, 3)
  providerRef       String?
  providerPayload   Json?
  signatureVerified Boolean           @default(false)
  verifiedAt        DateTime?
  verifiedById      String?
  verifiedBy        User?             @relation("PaymentVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  paidAt            DateTime?
  failedReason      String?
  // Payment-link / hosted-session tracking. A resend mints a fresh provider
  // session and records when and by whom it was issued, so link generation is
  // auditable and a settled payment is never re-linked.
  paymentUrl        String?           @db.Text
  linkSentAt        DateTime?
  linkSentById      String?
  linkSentBy        User?             @relation("PaymentLinkSender", fields: [linkSentById], references: [id], onDelete: SetNull)
  refunds           Refund[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([createdAt])
  @@index([linkSentById])
}

enum RefundStatus {
  PENDING
  COMPLETED
  FAILED
}

model Refund {
  id          String       @id @default(cuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // The specific payment being refunded. Nullable for legacy rows and for
  // store-credit refunds that are not tied to one gateway transaction.
  paymentId   String?
  payment     Payment?     @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  amountBhd   Decimal      @db.Decimal(12, 3)
  method      String       @default("BANK_TRANSFER")
  status      RefundStatus @default(COMPLETED)
  reason      String?
  reference   String?
  createdById String?
  createdBy   User?        @relation("RefundCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())

  @@index([orderId])
  @@index([paymentId])
  @@index([createdAt])
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  messageEn String?
  messageAr String?
  createdAt DateTime    @default(now())

  @@index([orderId])
}

// ───────────────────────────────────────────────────────────
// Wishlist & notifications
// ───────────────────────────────────────────────────────────

model WishlistItem {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
  @@index([customerId])
}

// Persistent cart. Guests are keyed by an opaque cookie token; signed-in
// customers by customerId. Both are merged on sign-in.
model Cart {
  id         String     @id @default(cuid())
  token      String?    @unique
  customerId String?    @unique
  customer   Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items      CartItem[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model CartItem {
  id        String          @id @default(cuid())
  cartId    String
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  variantId String?
  quantity  Int             @default(1)
  // Stable grouping key for one commercial line. Encodes product + variant +
  // the measurement configuration, so two pieces of the same product with
  // different measurements stay separate lines ("" for legacy non-measurement
  // lines, which the migration backfills to product|variant).
  configKey String          @default("")
  pieces    CartItemPiece[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([cartId, configKey])
  @@index([cartId])
}

// One physical piece inside a cart line, carrying its own measurement
// configuration. Written when the buyer configures a cut-based product; kept in
// lockstep with CartItem.quantity so checkout can snapshot each piece.
model CartItemPiece {
  id                  String           @id @default(cuid())
  cartItemId          String
  cartItem            CartItem         @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  pieceIndex          Int
  measurementKind     MeasurementKind?
  sizeCode            String?
  sizeSnapshot        Json?
  measurementSnapshot Json?
  cutId               String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@unique([cartItemId, pieceIndex])
  @@index([cartItemId])
}

model Notification {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  titleEn    String
  titleAr    String
  bodyEn     String?   @db.Text
  bodyAr     String?   @db.Text
  href       String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([customerId])
}

// ───────────────────────────────────────────────────────────
// Site content (admin-controlled) & settings
// ───────────────────────────────────────────────────────────

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model HomeSection {
  id             String   @id @default(cuid())
  key            String   @unique
  kind           String // hero | collections | featured | story | made_to_order | social | newsletter
  titleEn        String?
  titleAr        String?
  bodyEn         String?  @db.Text
  bodyAr         String?  @db.Text
  ctaLabelEn     String?
  ctaLabelAr     String?
  ctaHref        String?
  imageUrl       String?  @db.Text
  mobileImageUrl String?  @db.Text
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SocialLink {
  id        String  @id @default(cuid())
  platform  String
  url       String
  labelEn   String?
  labelAr   String?
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)
}

model Page {
  id          String   @id @default(cuid())
  slug        String   @unique
  titleEn     String
  titleAr     String
  bodyEn      String   @db.LongText
  bodyAr      String   @db.LongText
  metaTitleEn String?
  metaTitleAr String?
  metaDescEn  String?
  metaDescAr  String?
  noIndex     Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ShippingMethod {
  id            String   @id @default(cuid())
  code          String   @unique
  nameEn        String
  nameAr        String
  descriptionEn String?
  descriptionAr String?
  priceBhd      Decimal  @default(0) @db.Decimal(10, 3)
  freeOverBhd   Decimal? @db.Decimal(10, 3)
  countries     Json?
  courier       String?
  etaMinDays    Int      @default(2)
  etaMaxDays    Int      @default(5)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  locale    String   @default("en")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ───────────────────────────────────────────────────────────
// SEO
// ───────────────────────────────────────────────────────────

model Redirect {
  id         String   @id @default(cuid())
  fromPath   String   @unique
  toPath     String
  statusCode Int      @default(301)
  isEnabled  Boolean  @default(true)
  hits       Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ───────────────────────────────────────────────────────────
// Production / atelier
// ───────────────────────────────────────────────────────────

enum TailorStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

model Tailor {
  id             String             @id @default(cuid())
  code           String?            @unique
  nameEn         String
  nameAr         String
  phone          String?
  email          String?
  specialization String?
  capacity       Int                @default(4)
  status         TailorStatus       @default(ACTIVE)
  notes          String?            @db.Text
  // Settlement configuration
  settlementType String             @default("per_task") // per_task | monthly | hourly
  rateBhd        Decimal            @default(0) @db.Decimal(10, 3)
  // Portal login. Kept in a 1:1 side table so credentials are never loaded by
  // the many admin queries that read a tailor's display fields.
  credential     TailorCredential?
  tasks          ProductionTask[]
  settlements    TailorSettlement[]
  assignments    OrderItem[]        @relation("TailorAssignments")
  qcRecords      QcRecord[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([status])
}

// Authentication material for the future Tailor Portal. The password is only
// ever stored as a bcrypt hash; `mustChangePassword` supports the
// temporary-password flow and is cleared once the tailor sets their own.
// Tailors never self-register: an authorised admin issues the initial
// credentials. `sessionVersion` invalidates live sessions the moment an admin
// disables the account or resets the password.
model TailorCredential {
  id                   String    @id @default(cuid())
  tailorId             String    @unique
  tailor               Tailor    @relation(fields: [tailorId], references: [id], onDelete: Cascade)
  username             String    @unique
  passwordHash         String
  isActive             Boolean   @default(true)
  mustChangePassword   Boolean   @default(true)
  credentialsSentAt    DateTime?
  lastPasswordChangeAt DateTime?
  lastLoginAt          DateTime?
  sessionVersion       Int       @default(0)
  // Brute-force protection. Persisted (not in-memory) so a restart cannot clear
  // an in-progress lockout.
  failedLoginAttempts  Int       @default(0)
  lockedUntil          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([isActive])
}

enum TaskStatus {
  PENDING
  ASSIGNED
  ACCEPTED
  IN_PROGRESS
  SUBMITTED_FOR_QC
  COMPLETED
  REWORK
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model ProductionTask {
  id               String       @id @default(cuid())
  code             String       @unique
  orderId          String
  order            Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId      String?
  orderItem        OrderItem?   @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  productId        String?
  tailorId         String?
  tailor           Tailor?      @relation(fields: [tailorId], references: [id], onDelete: SetNull)
  titleEn          String
  titleAr          String?
  priority         TaskPriority @default(NORMAL)
  status           TaskStatus   @default(PENDING)
  // Frozen tailoring fee for this piece. Copied from the product/assignment at
  // creation time; never recalculated. There is no hidden fallback — a task
  // cannot be created without an explicit fee.
  feeBhd           Decimal?     @db.Decimal(10, 3)
  // Tailor acceptance
  acceptedAt       DateTime?
  dueDate          DateTime?
  startedAt        DateTime?
  submittedForQcAt DateTime?
  completedAt      DateTime?
  notes            String?      @db.Text
  qcRecords        QcRecord[]
  createdById      String?
  createdBy        User?        @relation("ProductionTaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([status])
  @@index([tailorId])
  @@index([orderId])
  @@index([orderItemId])
  @@index([dueDate])
}

enum QcStatus {
  PENDING
  PASSED
  FAILED
  REWORK_REQUIRED
}

model QcRecord {
  id              String         @id @default(cuid())
  taskId          String
  task            ProductionTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  orderItemId     String?
  orderItem       OrderItem?     @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  tailorId        String?
  tailor          Tailor?        @relation(fields: [tailorId], references: [id], onDelete: SetNull)
  // Attempt number within the item's QC history (1, 2, 3 …). History is never
  // overwritten: each QC run appends a new row.
  attempt         Int            @default(1)
  status          QcStatus       @default(PENDING)
  // Checklist
  measurementsOk  Boolean        @default(false)
  stitchingOk     Boolean        @default(false)
  fabricOk        Boolean        @default(false)
  finishingOk     Boolean        @default(false)
  accessoriesOk   Boolean        @default(false)
  packagingOk     Boolean        @default(false)
  // Mandatory when the result is FAILED / REWORK_REQUIRED — enforced in code.
  rejectionReason String?        @db.Text
  notes           String?        @db.Text
  checkedById     String?
  checkedBy       User?          @relation("QcChecker", fields: [checkedById], references: [id], onDelete: SetNull)
  checkedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([taskId])
  @@index([orderItemId])
  @@index([status])
}

enum SettlementStatus {
  PENDING
  APPROVED
  TRANSFERRED
  PAID
  CONFIRMED
  CANCELLED
}

model TailorSettlement {
  id                  String                 @id @default(cuid())
  number              String                 @unique
  tailorId            String
  tailor              Tailor                 @relation(fields: [tailorId], references: [id], onDelete: Cascade)
  periodStart         DateTime?
  periodEnd           DateTime?
  tasksCount          Int                    @default(0)
  grossBhd            Decimal                @default(0) @db.Decimal(12, 3)
  adjustmentsBhd      Decimal                @default(0) @db.Decimal(12, 3)
  paidBhd             Decimal                @default(0) @db.Decimal(12, 3)
  netBhd              Decimal                @default(0) @db.Decimal(12, 3)
  status              SettlementStatus       @default(PENDING)
  notes               String?                @db.Text
  // Transfer proof metadata (URL + free-text reference). Required to enter
  // TRANSFERRED — enforced in the settlement service, not just the UI.
  transferProofUrl    String?                @db.Text
  transferReference   String?
  transferredAt       DateTime?
  confirmedByTailorAt DateTime?
  approvedById        String?
  approvedBy          User?                  @relation("SettlementApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt          DateTime?
  paidAt              DateTime?
  items               TailorSettlementItem[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([tailorId])
  @@index([status])
}

// Explicit delivered pieces included in a settlement. The unique constraint on
// orderItemId is the database-level guarantee that a piece can never be settled
// twice, regardless of concurrent requests.
model TailorSettlementItem {
  id           String           @id @default(cuid())
  settlementId String
  settlement   TailorSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  orderItemId  String           @unique
  orderItem    OrderItem        @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  // Frozen tailoring fee captured at assignment; copied here for auditability.
  tailorFeeBhd Decimal          @db.Decimal(10, 3)
  createdAt    DateTime         @default(now())

  @@index([settlementId])
}

// ───────────────────────────────────────────────────────────
// Expenses
// ───────────────────────────────────────────────────────────

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PAID
}

// Stable machine type. Display names stay editable/localizable, but all logic
// keys off this enum so renaming a category can never change behaviour.
enum ExpenseCategoryType {
  GENERAL
  DELIVERY
  MATERIAL
  TAILOR_DUE
}

model ExpenseCategory {
  id        String              @id @default(cuid())
  type      ExpenseCategoryType @default(GENERAL)
  nameEn    String
  nameAr    String
  // System categories (e.g. the tailor-dues category) must not be deleted.
  isSystem  Boolean             @default(false)
  isActive  Boolean             @default(true)
  sortOrder Int                 @default(0)
  expenses  Expense[]

  @@index([isActive])
  @@index([type])
}

model Expense {
  id                String           @id @default(cuid())
  number            String           @unique
  categoryId        String?
  category          ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  description       String
  amountBhd         Decimal          @db.Decimal(12, 3)
  currencyCode      String           @default("BHD")
  amountPresentment Decimal?         @db.Decimal(12, 3)
  rateToBhd         Decimal          @default(1) @db.Decimal(18, 8)
  vendor            String?
  attachmentUrl     String?          @db.Text
  notes             String?          @db.Text
  expenseDate       DateTime         @default(now())
  status            ExpenseStatus    @default(DRAFT)
  // Optional links so a system expense can point at what it settles without
  // duplicating a financial deduction.
  orderId           String?
  settlementId      String?
  productId         String?
  submittedById     String?
  submittedBy       User?            @relation("ExpenseSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  approvedById      String?
  approvedBy        User?            @relation("ExpenseApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt        DateTime?
  approvalNote      String?
  paidAt            DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([status])
  @@index([expenseDate])
  @@index([categoryId])
  @@index([orderId])
  @@index([settlementId])
}

// ───────────────────────────────────────────────────────────
// Staff notifications
// ───────────────────────────────────────────────────────────

enum StaffNotificationType {
  ORDER
  PAYMENT
  STOCK
  PRODUCTION
  QC
  EXPENSE
  REFUND
  CUSTOMER
  SYSTEM
}

model StaffNotification {
  id        String                @id @default(cuid())
  type      StaffNotificationType @default(SYSTEM)
  titleEn   String
  titleAr   String
  bodyEn    String?               @db.Text
  bodyAr    String?               @db.Text
  href      String?
  userId    String?
  user      User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt    DateTime?
  createdAt DateTime              @default(now())

  @@index([userId, readAt])
  @@index([createdAt])
}

// ───────────────────────────────────────────────────────────
// Shipping companies (DB-managed carriers)
// ───────────────────────────────────────────────────────────

model ShippingCompany {
  id        String   @id @default(cuid())
  code      String   @unique // ARAMEX / DHL / ZAJIL
  nameEn    String
  nameAr    String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

// ───────────────────────────────────────────────────────────
// Quick Order links — customer-facing link foundation
// ───────────────────────────────────────────────────────────

enum QuickOrderSource {
  WHATSAPP
  INSTAGRAM
}

// A shareable, non-guessable link that opens a server-resolved product page for
// a customer. Nothing trusted (price, name, availability) is encoded here — the
// product is resolved live from the catalogue when the link is opened.
model QuickOrderLink {
  id            String           @id @default(cuid())
  // Internal human-readable id, e.g. QOL-2609-000123.
  code          String           @unique
  // Public URL token. High-entropy; unique at the database level.
  token         String           @unique
  productId     String
  source        QuickOrderSource @default(WHATSAPP)
  createdById   String?
  createdBy     User?            @relation("QuickOrderLinkCreator", fields: [createdById], references: [id], onDelete: SetNull)
  customerPhone String?
  sentAt        DateTime?
  openedAt      DateTime?
  orderId       String?
  order         Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  expiresAt     DateTime?
  revokedAt     DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([productId])
  @@index([orderId])
  @@index([createdById])
}

// ───────────────────────────────────────────────────────────
// Membership tiers (admin-defined)
// ───────────────────────────────────────────────────────────

model MembershipTier {
  id            String     @id @default(cuid())
  code          String     @unique
  nameEn        String
  nameAr        String
  // Minimum count of qualifying paid, non-refunded abayas.
  minQualifying Int        @default(0)
  isActive      Boolean    @default(true)
  sortOrder     Int        @default(0)
  customers     Customer[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([isActive])
}

// ───────────────────────────────────────────────────────────
// Notification rules (event → recipients)
// ───────────────────────────────────────────────────────────

enum NotificationTargetType {
  STAFF
  TAILOR
}

// Configurable mapping from a domain event key to recipients. The dispatch
// foundation consults these rows; nothing is hard-coded in call sites.
model NotificationRule {
  id                 String                 @id @default(cuid())
  eventKey           String // e.g. order.created, qc.failed
  nameEn             String
  nameAr             String
  targetType         NotificationTargetType @default(STAFF)
  // Permission required to receive this event (staff targets only).
  requiredPermission String?
  priority           TaskPriority           @default(NORMAL)
  isActive           Boolean                @default(true)
  sortOrder          Int                    @default(0)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@unique([eventKey, targetType])
  @@index([isActive])
}

// ───────────────────────────────────────────────────────────
// Human-readable sequences
// ───────────────────────────────────────────────────────────

// Concurrency-safe counters for human-readable identifiers. Allocation uses a
// guarded increment inside a transaction so two concurrent requests can never
// receive the same number.
model SequenceCounter {
  id        String   @id @default(cuid())
  key       String   @unique // e.g. order:2026-09, expense, settlement
  prefix    String
  scope     String? // e.g. YYYYMM for monthly-reset sequences
  value     Int      @default(0)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([key])
}
